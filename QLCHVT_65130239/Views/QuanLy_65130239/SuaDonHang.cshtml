@model QLCHVT_65130239.Models.DONHANG

@{
    ViewBag.Title = "Cập nhật đơn hàng";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center mb-4">
                <a href="@Url.Action("DanhSachDonHang")" class="btn btn-outline-secondary border-0 btn-sm me-3" style="border-radius: 10px;">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <h4 class="fw-bold mb-0">Cập nhật thông tin đơn hàng <span class="text-primary">#@Model.MADH.Trim()</span></h4>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.MADH)

                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="card border-0 shadow-sm p-4" style="border-radius: 20px;">
                            <h6 class="fw-bold text-uppercase small text-muted mb-4">Điều phối & Trạng thái</h6>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Trạng thái đơn</label>
                                    <select name="TRANGTHAI" class="form-select bg-light border-0 py-2" style="border-radius: 10px;">
                                        <option value="CHODUYET" @(Model.TRANGTHAI.Trim() == "CHODUYET" ? "selected" : "")>Chờ duyệt</option>
                                        <option value="CHODUYET" @(Model.TRANGTHAI.Trim() == "DADUYET" ? "selected" : "")>Chờ duyệt</option>
                                        <option value="DANGGIAO" @(Model.TRANGTHAI.Trim() == "DANGGIAO" ? "selected" : "")>Đang giao</option>
                                        <option value="HOANTHANH" @(Model.TRANGTHAI.Trim() == "HOANTAT" ? "selected" : "")>Hoàn tất</option>
                                        <option value="DAHUY" @(Model.TRANGTHAI.Trim() == "DAHUY" ? "selected" : "")>Đã hủy</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Phí vận chuyển</label>
                                    <div class="input-group">
                                        <input type="number" name="PHIVANCHUYEN" class="form-control bg-light border-0 py-2" style="border-radius: 10px 0 0 10px;" value="@Model.PHIVANCHUYEN">
                                        <span class="input-group-text bg-light border-0 small">đ</span>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Nhân viên Duyệt đơn</label>
                                    @Html.DropDownList("MANV_DUYET", null, "-- Chọn nhân viên --", new { @class = "form-select bg-light border-0 py-2", style = "border-radius: 10px;" })
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-bold">Nhân viên Giao hàng</label>
                                    @Html.DropDownList("MANV_GIAO", null, "-- Chọn nhân viên --", new { @class = "form-select bg-light border-0 py-2", style = "border-radius: 10px;" })
                                </div>

                                <div class="col-12 mt-3">
                                    <label class="form-label small fw-bold">Địa chỉ giao hàng thực tế</label>
                                    <textarea name="DIACHIGIAO" class="form-control bg-light border-0 py-2" rows="3" style="border-radius: 12px;">@Model.DIACHIGIAO</textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="card border-0 shadow-sm p-4 bg-primary text-white" style="border-radius: 20px;">
                            <h6 class="fw-bold text-uppercase small mb-4 opacity-75">Tóm tắt đơn hàng</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small opacity-75">Khách hàng:</span>
                                <span class="fw-bold">@Model.KHACHHANG.TENKH</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="small opacity-75">Ngày đặt:</span>
                                <span class="fw-bold small">@Model.NGAYLAP.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <hr class="opacity-25">
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h6 mb-0">Tổng thanh toán:</span>
                                <span class="h4 fw-bold mb-0">@String.Format("{0:N0}", Model.TONGTIEN) đ</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary py-3 shadow" style="border-radius: 12px; font-weight: 600;">
                                <i class="bi bi-check-circle me-2"></i>Lưu thay đổi
                            </button>
                            <a href="@Url.Action("DanhSachDonHang")" class="btn btn-light py-3" style="border-radius: 12px; color: #666;">
                                Hủy bỏ
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>