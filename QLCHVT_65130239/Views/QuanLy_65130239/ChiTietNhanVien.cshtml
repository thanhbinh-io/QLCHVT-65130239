@model QLCHVT_65130239.Models.NHANVIEN

@{
    ViewBag.Title = "Hồ sơ nhân viên";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card admin-card shadow-sm border-0 text-center p-5">
                <div class="mx-auto bg-primary bg-gradient text-white d-flex align-items-center justify-content-center rounded-circle mb-4 shadow"
                     style="width: 120px; height: 120px; font-size: 3.5rem; font-weight: 800;">
                    @Model.TENNV.Substring(0, 1).ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.TENNV</h4>
                <p class="text-muted small mb-3">ID: @Model.MANV.Trim()</p>
                <span class="badge @(Model.VAITRO == 0 ? "bg-danger" : "bg-success") rounded-pill px-4 py-2">
                    @(Model.VAITRO == 0 ? "Ngưng hoạt động" : "Đang hoạt động")
                </span>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card admin-card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary"><i class="bi bi-info-circle me-2"></i>Thông tin tài khoản</h5>

                    <div class="row gy-4">
                        <div class="col-sm-6">
                            <label class="small text-muted d-block">Địa chỉ Email</label>
                            <span class="fw-bold text-dark fs-5">@Model.EMAIL</span>
                        </div>
                        <div class="col-sm-6">
                            <label class="small text-muted d-block">Số điện thoại</label>
                            <span class="fw-bold text-dark fs-5">@Model.SDT</span>
                        </div>

                        <div class="col-sm-6">
                            <label class="small text-muted d-block">Mật khẩu truy cập</label>
                            <div class="d-flex align-items-center gap-2">
                                <span id="pwdText" class="fw-bold text-dark fs-5">••••••</span>
                                <button class="btn btn-sm btn-light border-0" type="button" onclick="togglePassword()">
                                    <i id="eyeIcon" class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="small text-muted d-block">Vai trò hệ thống</label>
                            <span class="fw-bold text-primary">
                                @(Model.VAITRO == 1 ? "Quản lý" : Model.VAITRO == 2 ? "Duyệt đơn" : "Giao hàng")
                            </span>
                        </div>
                    </div>

                    <div class="alert alert-warning border-0 mt-5 mb-0 d-flex align-items-center" style="border-radius: 10px; background-color: #fff9db;">
                        <i class="bi bi-exclamation-triangle-fill me-3 fs-4 text-warning"></i>
                        <small class="text-dark">
                            <strong>Lưu ý bảo mật:</strong> Chỉ cung cấp mật khẩu cho đúng nhân viên sở hữu tài khoản.
                            Không chia sẻ thông tin này ra bên ngoài.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        var pwd = "@Model.MATKHAU"; // Lấy mật khẩu từ Model
        var textElement = document.getElementById("pwdText");
        var iconElement = document.getElementById("eyeIcon");

        if (textElement.innerText === "••••••") {
            textElement.innerText = pwd; // Hiện mật khẩu thật
            iconElement.classList.remove("bi-eye");
            iconElement.classList.add("bi-eye-slash");
        } else {
            textElement.innerText = "••••••"; // Ẩn đi
            iconElement.classList.remove("bi-eye-slash");
            iconElement.classList.add("bi-eye");
        }
    }
</script>