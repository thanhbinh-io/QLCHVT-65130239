@model IEnumerable<QLCHVT_65130239.Models.SANPHAM>

@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}

<style>
    /* GIỮ NGUYÊN CÁC STYLE CŨ CỦA BẠN */
    body {
        background-color: #f9fafb;
    }

    .admin-card {
        border-radius: 15px;
        border: none;
        background: #ffffff;
    }

    .table thead th {
        background-color: #f1f5f9;
        color: #475569;
        text-transform: uppercase;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 15px;
        border: none;
    }

    .table tbody td {
        padding: 15px;
        border-bottom: 1px solid #f1f5f9;
    }

    .badge-soft-danger {
        background-color: #fee2e2;
        color: #dc2626;
        border: none;
        padding: 6px 12px;
    }

    .badge-soft-success {
        background-color: #dcfce7;
        color: #166534;
        border: none;
        padding: 6px 12px;
    }

    .badge-soft-info {
        background-color: #e0f2fe;
        color: #0369a1;
        border: none;
    }

    .img-container {
        background-color: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 2px;
        border-radius: 10px;
    }

    /* BỔ SUNG STYLE CHO THANH TÌM KIẾM ĐỂ ĐỒNG BỘ VỚI NHÂN VIÊN */
    .input-group-search {
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        transition: all 0.3s ease;
    }

        .input-group-search:focus-within {
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
            border-color: #6366f1;
        }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0" style="letter-spacing: -0.5px;">Quản lý kho sản phẩm</h3>
            <p class="text-muted small">Hệ thống theo dõi vật tư thiết bị</p>
        </div>
        <a href="@Url.Action("Create", "QuanLy_65130239")" class="btn btn-primary shadow-sm px-4 fw-bold" style="border-radius: 10px;">
            <i class="bi bi-plus-lg me-2"></i> Thêm sản phẩm mới
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-12 col-md-6">
            <form action="@Url.Action("DanhSachSanPham", "QuanLy_65130239")" method="get">
                <div class="input-group input-group-search shadow-sm">
                    <span class="input-group-text bg-white border-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-0 ps-0"
                           placeholder="Tìm theo tên hoặc mã sản phẩm..."
                           value="@ViewBag.CurrentSearch">
                    <button class="btn btn-dark px-4" type="submit">Tìm kiếm</button>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch))
                    {
                        <a href="@Url.Action("DanhSachSanPham")" class="btn btn-light border-0 px-3" title="Xóa tìm kiếm">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card admin-card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-1 text-muted"></i>
                    <p class="mt-3 text-muted">Không tìm thấy sản phẩm nào khớp với: "<strong>@ViewBag.CurrentSearch</strong>"</p>
                    <a href="@Url.Action("DanhSachSanPham")" class="btn btn-outline-primary btn-sm mt-2">Quay lại danh sách</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Sản phẩm</th>
                                <th>Mã SP</th>
                                <th>Đơn vị</th>
                                <th class="text-end">Giá nhập</th>
                                <th class="text-end">Giá bán</th>
                                <th class="text-center">Tồn kho</th>
                                <th class="pe-4 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="img-container me-3 shadow-sm">
                                                @if (!string.IsNullOrEmpty(item.HINHANH))
                                                {
                                                    <img src="~/Images/@item.HINHANH" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" alt="@item.TENSP" />
                                                }
                                                else
                                                {
                                                    <div class="text-muted d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                                        <i class="bi bi-box"></i>
                                                    </div>
                                                }
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark" style="font-size: 0.95rem;">@item.TENSP</div>
                                                <div class="text-muted small"> @(item.NHOMSANPHAM != null ? item.NHOMSANPHAM.TENNHOM : "Vật tư")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge badge-soft-info rounded-pill">@item.MASP</span></td>
                                    <td><span class="text-secondary small">@item.DONVI</span></td>
                                    <td class="text-end">
                                        <span class="text-muted small">@String.Format("{0:N0}", item.GIANHAP) <small>đ</small></span>
                                    </td>
                                    <td class="text-end">
                                        <span class="fw-bold text-dark">@String.Format("{0:N0}", item.GIABAN) <small>đ</small></span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.SOLUONG <= 20)
                                        {
                                            <span class="badge badge-soft-danger rounded-pill fw-bold">
                                                <i class="bi bi-exclamation-triangle me-1"></i> @item.SOLUONG
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-success rounded-pill fw-bold">
                                                @item.SOLUONG
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a href="@Url.Action("SuaSanPham", "QuanLy_65130239", new { id = item.MASP.Trim() })"
                                               class="btn btn-light btn-sm text-warning shadow-sm border" title="Sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <a href="@Url.Action("ChiTietSanPham", "QuanLy_65130239", new { id = item.MASP.Trim() })"
                                               class="btn btn-light btn-sm text-info shadow-sm border" title="Chi tiết">
                                                <i class="bi bi-info-circle"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>