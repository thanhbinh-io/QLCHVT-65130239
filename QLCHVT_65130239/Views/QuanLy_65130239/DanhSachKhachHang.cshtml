@model IEnumerable<QLCHVT_65130239.Models.KHACHHANG>

@{
    ViewBag.Title = "Quản lý Khách hàng";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Quản lý Khách hàng</h3>
            <p class="text-muted small">Quản lý thông tin và trạng thái tài khoản người mua</p>
        </div>

        <div class="d-flex gap-2">
            @using (Html.BeginForm("DanhSachKhachHang", "QuanLy_65130239", FormMethod.Get, new { @class = "d-flex shadow-sm" }))
            {
                <input type="text" name="searchString" class="form-control border-0 px-3"
                       placeholder="Tìm tên hoặc mã KH..." style="border-radius: 10px 0 0 10px; min-width: 250px;"
                       value="@ViewBag.SearchValue">
                <button type="submit" class="btn btn-primary px-3" style="border-radius: 0 10px 10px 0;">
                    <i class="bi bi-search"></i>
                </button>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted fw-bold">KHÁCH HÀNG</th>
                        <th class="py-3 text-muted fw-bold">LIÊN LẠC</th>
                        <th class="py-3 text-muted fw-bold text-center">TRẠNG THÁI</th>
                        <th class="py-3 text-muted fw-bold text-end pe-4">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm me-3 bg-info-subtle text-info d-flex align-items-center justify-content-center rounded-circle fw-bold"
                                         style="width: 40px; height: 40px;">
                                        @item.TENKH.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@item.TENKH</div>
                                        <small class="text-muted">ID: @item.MAKH.Trim()</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small"><i class="bi bi-envelope me-2 text-muted"></i>@item.EMAIL</div>
                                <div class="small"><i class="bi bi-telephone me-2 text-muted"></i>@item.SDT</div>
                            </td>
                            <td class="text-center">
                                @if (item.TRANGTHAI == 1)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success px-3 rounded-pill">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger px-3 rounded-pill">Hạn chế</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                    <a href="@Url.Action("ChiTietKhachHang", new { id = item.MAKH.Trim() })" class="btn btn-white btn-sm px-3 border" title="Chi tiết">
                                        <i class="bi bi-eye text-primary"></i>
                                    </a>
                                    <a href="@Url.Action("SuaKhachHang", new { id = item.MAKH.Trim() })" class="btn btn-white btn-sm px-3 border" title="Chỉnh sửa">
                                        <i class="bi bi-pencil text-warning"></i>
                                    </a>

                                    @* THAY THẾ NÚT XÓA BẰNG NÚT HẠN CHẾ/MỞ KHÓA *@
                                    <a href="@Url.Action("ThayDoiTrangThaiKH", new { id = item.MAKH.Trim() })"
                                       class="btn btn-white btn-sm px-3 border"
                                       title="@(item.TRANGTHAI == 1 ? "Hạn chế tài khoản" : "Mở khóa tài khoản")"
                                       onclick="return confirm('Bạn có chắc chắn muốn @(item.TRANGTHAI == 1 ? "Hạn chế" : "Mở khóa") khách hàng này?')">
                                        <i class="bi @(item.TRANGTHAI == 1 ? "bi-person-x text-danger" : "bi-person-check text-success")"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-people text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted">Không tìm thấy khách hàng nào phù hợp.</p>
                <a href="@Url.Action("DanhSachKhachHang")" class="btn btn-link">Xem tất cả</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(id) {
            if (confirm('Bạn có chắc chắn muốn xóa khách hàng này?')) {
                // Gửi request xóa ở đây (thường là POST)
                window.location.href = '/QuanLy_65130239/XoaKhachHang/' + id;
            }
        }
    </script>
}