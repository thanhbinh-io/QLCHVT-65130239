@model QLCHVT_65130239.Models.KHACHHANG

@{
    ViewBag.Title = "Hồ sơ khách hàng";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <a href="@Url.Action("DanhSachKhachHang")" class="btn btn-light btn-sm border shadow-sm mb-2">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h3 class="fw-bold text-dark">Hồ sơ khách hàng</h3>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card admin-card shadow-sm border-0 text-center p-5">
                <div class="mx-auto bg-info bg-gradient text-white d-flex align-items-center justify-content-center rounded-circle mb-4 shadow"
                     style="width: 120px; height: 120px; font-size: 3.5rem; font-weight: 800;">
                    @Model.TENKH.Substring(0, 1).ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.TENKH</h4>
                <p class="text-muted small">Mã KH: @Model.MAKH.Trim()</p>

                <div class="mt-3">
                    @if (Model.TRANGTHAI == 1)
                    {
                        <span class="badge bg-success-subtle text-success border border-success px-4 py-2 rounded-pill">Tài khoản hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger px-4 py-2 rounded-pill">Tài khoản bị hạn chế</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card admin-card shadow-sm border-0 h-100 p-4">
                <h5 class="fw-bold mb-4 border-bottom pb-2 text-primary">Thông tin định danh</h5>
                <div class="row gy-4">
                    <div class="col-sm-6">
                        <label class="small text-muted d-block">Email</label>
                        <span class="fw-bold text-dark fs-5">@Model.EMAIL</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="small text-muted d-block">Số điện thoại</label>
                        <span class="fw-bold text-dark fs-5">@Model.SDT</span>
                    </div>
                    <div class="col-sm-6">
                        <label class="small text-muted d-block">Mật khẩu tài khoản</label>
                        <div class="d-flex align-items-center gap-2">
                            <span id="pwdText" class="fw-bold text-dark fs-5">••••••</span>
                            <button class="btn btn-sm btn-light border" type="button" onclick="togglePassword()">
                                <i id="eyeIcon" class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="mt-5 pt-3 border-top">
                    <a href="@Url.Action("SuaKhachHang", new { id = Model.MAKH.Trim() })" class="btn btn-warning px-4 fw-bold shadow-sm">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function togglePassword() {
        var pwd = "@Model.MATKHAU";
        var textElement = document.getElementById("pwdText");
        var iconElement = document.getElementById("eyeIcon");
        if (textElement.innerText === "••••••") {
            textElement.innerText = pwd;
            iconElement.className = "bi bi-eye-slash";
        } else {
            textElement.innerText = "••••••";
            iconElement.className = "bi bi-eye";
        }
    }
</script>