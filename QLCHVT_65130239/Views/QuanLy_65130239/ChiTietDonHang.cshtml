@model QLCHVT_65130239.Models.DONHANG
@{
    ViewBag.Title = "Cập nhật đơn hàng";
    Layout = "~/Views/Shared/_LayoutQuanLy.cshtml";
}
<div class="container py-4">
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold text-dark">Chi tiết đơn hàng #@Model.MADH.Trim()</h5>
            <div class="badge bg-soft-primary text-primary p-2 px-3" style="border-radius: 10px;">
                @Model.TRANGTHAI.Trim()
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 20px;">
                <div class="card-body p-4">
                    <section class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold mb-2 d-block">Khách hàng</label>
                        <h6 class="fw-bold text-dark mb-1">@Model.KHACHHANG.TENKH</h6>
                        <p class="text-primary small fw-bold mb-0">@Model.KHACHHANG.SDT</p>
                    </section>

                    <section class="mb-4 pt-3 border-top">
                        <label class="text-muted small text-uppercase fw-bold mb-2 d-block">Vận chuyển đến</label>
                        <p class="small text-dark">@Model.DIACHIGIAO</p>
                    </section>

                    <section class="pt-3 border-top">
                        <label class="text-muted small text-uppercase fw-bold mb-2 d-block">Nhân sự thực hiện</label>
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-person-check me-2 text-success"></i>
                            <span class="small">Duyệt: <strong>@(Model.NHANVIEN?.TENNV ?? "---")</strong></span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="bi bi-truck me-2 text-info"></i>
                            <span class="small">Giao: <strong>@(Model.NHANVIEN1?.TENNV ?? "---")</strong></span>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm" style="border-radius: 20px;">
                <div class="card-body p-0">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr class="small text-muted text-uppercase">
                                <th class="ps-4 py-3">Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CTDHs)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark">@item.SANPHAM.TENSP</div>
                                        <small class="text-muted">Đơn giá: @String.Format("{0:N0}", item.DONGIA) đ</small>
                                    </td>
                                    <td class="text-center fw-bold">@item.SOLUONG</td>
                                    <td class="text-end pe-4 fw-bold">@String.Format("{0:N0}", item.SOLUONG * item.DONGIA) đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light bg-opacity-50">
                            <tr>
                                <td colspan="2" class="text-end py-3 text-muted small">Phí vận chuyển</td>
                                <td class="text-end pe-4 small fw-bold">@String.Format("{0:N0}", Model.PHIVANCHUYEN) đ</td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-end py-3 fw-bold">Tổng thanh toán</td>
                                <td class="text-end pe-4 fw-bold text-danger h5 mb-0">@String.Format("{0:N0}", Model.TONGTIEN) đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-soft-primary {
        background-color: #eef2ff;
    }
</style>