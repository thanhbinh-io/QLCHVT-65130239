                                <img src="@(!string.IsNullOrEmpty(item.HINHANH) ? Url.Content("~/Images/" + item.HINHANH) : "https://via.placeholder.com/300")" alt="@item.TENSP">
                            </div>
                        </a>
                        <div class="card-body">
                            <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239", new { id = item.MASP.Trim() })" class="product-title">@item.TENSP</a>
                            <div class="price-tag">@String.Format("{0:0,0}", item.GIABAN) ₫<small class="text-muted fw-normal" style="font-size: 0.8rem">/@item.DONVI</small></div>
                            <a href="@Url.Action("ThemGioHang", "GioHang_65130239", new { maSP = item.MASP.Trim(), url = Request.Url.ToString() })" class="btn btn-add-cart"><i class="fas fa-cart-plus me-1"></i> Thêm giỏ hàng</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div id="thiet-bi-nuoc" class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="text-uppercase fw-bold m-0" style="color: var(--accent-blue);"><i class="fas fa-tint me-2"></i>Thiết Bị Nước</h3>
    </div>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (spNuoc != null)
        {
            foreach (var item in spNuoc)
            {
                <div class="col">
                    <div class="product-card">
                        <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239", new { id = item.MASP.Trim() })">
                            <div class="product-img-wrapper">
                                <img src="@(!string.IsNullOrEmpty(item.HINHANH) ? Url.Content("~/Images/" + item.HINHANH) : "https://via.placeholder.com/300")" alt="@item.TENSP">
                            </div>
                        </a>
                        <div class="card-body">
                            <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239", new { id = item.MASP.Trim() })" class="product-title">@item.TENSP</a>
                            <div class="price-tag">@String.Format("{0:0,0}", item.GIABAN) ₫<small class="text-muted fw-normal" style="font-size: 0.8rem">/@item.DONVI</small></div>
                            <a href="@Url.Action("ThemGioHang", "GioHang_65130239", new { maSP = item.MASP.Trim(), url = Request.Url.ToString() })" class="btn btn-add-cart"><i class="fas fa-cart-plus me-1"></i> Thêm giỏ hàng</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>