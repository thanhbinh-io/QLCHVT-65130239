@model IEnumerable<QLCHVT_65130239.Models.SANPHAM>

@{
    ViewBag.Title = "Danh sách Sản phẩm";
    Layout = "~/Views/Shared/_LayoutTrangChu2.cshtml";
}

<style>
    :root {
        --primary-blue: #0056b3;
        --accent-blue: #00adef;
        --text-dark: #333;
    }

    /* Thẻ sản phẩm tổng thể */
    .product-card {
        border: none;
        border-radius: 15px;
        background: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .product-card:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            transform: translateY(-8px);
        }

    /* Vùng chứa ảnh */
    .product-img-wrapper {
        position: relative;
        padding-top: 100%; /* Tạo khung vuông */
        overflow: hidden;
        background-color: #f8f9fa;
    }

        .product-img-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 15px;
            transition: transform 0.5s ease;
        }

    .product-card:hover .product-img-wrapper img {
        transform: scale(1.1);
    }

    /* Nhãn hết hàng/Mới */
    .status-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 2;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    /* Tiêu đề sản phẩm */
    .product-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-decoration: none;
        height: 2.8rem;
        line-height: 1.4;
    }

        .product-title:hover {
            color: var(--accent-blue);
        }

    /* Giá cả */
    .price-tag {
        color: #d32f2f;
        font-weight: 800;
        font-size: 1.15rem;
    }

    /* Nút thêm giỏ hàng */
    .btn-add-cart {
        background-color: white;
        color: var(--primary-blue);
        border: 2px solid var(--primary-blue);
        border-radius: 25px;
        font-weight: 700;
        transition: all 0.3s;
        width: 100%;
        padding: 8px;
        margin-top: auto;
    }

        .btn-add-cart:hover {
            background-color: var(--primary-blue);
            color: white;
        }

    /* Vùng thông báo trống */
    .empty-state {
        padding: 80px 20px;
        background: white;
        border-radius: 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    }
</style>

<div class="container ">

    <div class="row mb-5 justify-content-center">
        <div class="col-md-7">
            @using (Html.BeginForm("Index", "SanPham_65130239", FormMethod.Get))
            {
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                    <input type="text" name="searchString" class="form-control border-0 ps-4"
                           placeholder="Nhập tên sản phẩm bạn cần tìm..."
                           value="@Request.QueryString["searchString"]" />
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="fas fa-search me-2"></i>Tìm kiếm
                    </button>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "TrangChu_65130239")" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active">Sản phẩm</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-uppercase" style="color: var(--primary-blue); letter-spacing: 1px;">
                <i class="fas fa-tools me-2"></i>Tất cả sản phẩm
            </h2>
        </div>
        <div class="text-muted">
            Hiển thị: <strong>@Model.Count()</strong> sản phẩm
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <img src="https://cdn-icons-png.flaticon.com/512/7486/7486744.png" alt="No results" style="width: 120px;" class="mb-4 opacity-75">
            <h3 class="fw-bold text-dark">Rất tiếc!</h3>
            <p class="text-muted fs-5">Chúng tôi không tìm thấy sản phẩm "@Request.QueryString["searchString"]" trong hệ thống.</p>
            <div class="mt-4">
                <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239")" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow">
                    <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="product-card">

                        @if (item.SOLUONG <= 0)
                        {
                            <span class="status-badge bg-danger text-white">Hết hàng</span>
                        }
                        else if (item.SOLUONG <= 5)
                        {
                            <span class="status-badge bg-warning text-dark">Sắp hết</span>
                        }

                        <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239", new { id = item.MASP.Trim() })" class="text-decoration-none">
                            <div class="product-img-wrapper">
                                <img src="@(!string.IsNullOrEmpty(item.HINHANH) ? Url.Content("~/Images/" + item.HINHANH) : "https://via.placeholder.com/300")"
                                     alt="@item.TENSP"
                                     onerror="this.src='https://via.placeholder.com/300?text=No+Image'" />
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column p-3">
                            <a href="@Url.Action("ChiTietSanPham", "TrangChu_65130239", new { id = item.MASP.Trim() })"
                               class="product-title" title="@item.TENSP">
                                @item.TENSP
                            </a>

                            <div class="small text-muted mb-2">
                                <i class="fas fa-tag me-1"></i> @(item.NHOMSANPHAM != null ? item.NHOMSANPHAM.TENNHOM : "Vật tư")
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-auto">
                                <div class="price-tag">@String.Format("{0:0,0}", item.GIABAN) ₫</div>
                                <small class="badge bg-light text-dark fw-normal border">/@item.DONVI</small>
                            </div>

                            @if (item.SOLUONG > 0)
                            {
                                <a href="@Url.Action("ThemGioHang", "GioHang_65130239", new { maSP = item.MASP.Trim(), url = Request.Url.ToString() })"
                                   class="btn btn-add-cart mt-3 shadow-sm">
                                    <i class="fas fa-cart-plus me-2"></i>Thêm giỏ hàng
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-secondary mt-3 disabled rounded-pill opacity-50">
                                    <i class="fas fa-box-open me-2"></i>Tạm hết hàng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

