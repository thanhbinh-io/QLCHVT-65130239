
@{
    ViewBag.Title = "ChiTietKhachHang";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

@model QLCHVT_65130239.Models.KHACHHANG

@{
    ViewBag.Title = "Chi tiết khách hàng";
}

<h4 class="mb-4">
    <i class="fas fa-user text-primary me-2"></i>
    Chi tiết khách hàng
</h4>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">Mã khách hàng:</div>
            <div class="col-md-8">@Model.MAKH</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">Tên khách hàng:</div>
            <div class="col-md-8">@Model.TENKH</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">Email:</div>
            <div class="col-md-8">@Model.EMAIL</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4 fw-bold">Số điện thoại:</div>
            <div class="col-md-8">@Model.SDT</div>
        </div>

      

        <div class="text-end">
            <a href="@Url.Action("SuaKhachHang", new { id = Model.MAKH })"
               class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Chỉnh sửa
            </a>

            <a href="javascript:history.back()"
               class="btn btn-secondary">
                Quay lại
            </a>
        </div>

    </div>
</div>


