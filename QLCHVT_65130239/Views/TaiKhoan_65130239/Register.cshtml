@model QLCHVT_65130239.Models.KHACHHANG

@{
    ViewBag.Title = "Đăng ký thành viên";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

<style>
    .register-container {
        min-height: 90vh;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
    }

    .card-register {
        border: none;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }

    .register-left {
        background: #0d6efd;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 40px;
    }

    .register-right {
        padding: 40px;
        background: white;
    }

    .form-floating > label {
        padding-left: 20px;
    }

    .form-control {
        border-radius: 10px;
        padding-left: 20px;
        background-color: #f8f9fa;
        border: 1px solid #eee;
    }

        .form-control:focus {
            background-color: #fff;
            border-color: #0d6efd;
            box-shadow: none;
        }

    .btn-register {
        border-radius: 50px;
        padding: 12px;
        font-weight: bold;
        background: #0d6efd;
        border: none;
        transition: all 0.3s;
    }

        .btn-register:hover {
            background: #0056b3;
            transform: translateY(-2px);
        }
</style>

<div class="register-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <div class="card card-register overflow-hidden">
                    <div class="row g-0">
                        <div class="col-md-5 register-left d-none d-md-flex">
                            <i class="fas fa-store fa-4x mb-4"></i>
                            <h3 class="fw-bold">Gia nhập ngay!</h3>
                            <p class="mt-3">Tạo tài khoản để theo dõi đơn hàng và nhận nhiều ưu đãi hấp dẫn từ chúng tôi.</p>
                            <a href="@Url.Action("Login", "TaiKhoan_65130239")" class="btn btn-outline-light rounded-pill mt-3 px-4">
                                Đã có tài khoản?
                            </a>
                        </div>

                        <div class="col-md-7 register-right">
                            <h3 class="fw-bold text-center mb-4 text-primary">Đăng Ký Tài Khoản</h3>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger py-2 small rounded-3">
                                    <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
                                </div>
                            }

                            @using (Html.BeginForm("Register", "TaiKhoan_65130239", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <div class="form-floating mb-3">
                                    @Html.TextBoxFor(m => m.TENKH, new { @class = "form-control", @placeholder = "Họ tên", required = "required" })
                                    <label>Họ và tên</label>
                                </div>

                                <div class="form-floating mb-3">
                                    @Html.TextBoxFor(m => m.EMAIL, new { @class = "form-control", @placeholder = "Email", type = "email", required = "required" })
                                    <label>Địa chỉ Email (Gmail)</label>
                                </div>

                                <div class="form-floating mb-3">
                                    @Html.TextBoxFor(m => m.SDT, new { @class = "form-control", @placeholder = "SĐT", required = "required" })
                                    <label>Số điện thoại</label>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <div class="form-floating position-relative">
                                            @Html.PasswordFor(m => m.MATKHAU, new { @class = "form-control input-password", @placeholder = "Mật khẩu", required = "required", minlength = "6" })
                                            <label>Mật khẩu</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <div class="form-floating">
                                            <input type="password" class="form-control input-password"
                                                   name="XacNhanMatKhau" placeholder="Xác nhận" required>
                                            <label>Xác nhận lại</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3 form-check">
                                    <input type="checkbox" class="form-check-input" id="showPass">
                                    <label class="form-check-label small user-select-none" for="showPass">Hiển thị mật khẩu</label>
                                </div>

                                <button type="submit" class="btn btn-primary w-100 btn-register text-white text-uppercase shadow-sm mt-2">
                                    Đăng ký ngay
                                </button>
                            }

                            <div class="text-center mt-4 d-md-none">
                                <span class="text-muted small">Đã có tài khoản?</span>
                                <a href="@Url.Action("Login", "TaiKhoan_65130239")" class="fw-bold text-decoration-none">Đăng nhập</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Index", "TrangChu_65130239")" class="text-muted text-decoration-none small">
                        <i class="fas fa-chevron-left me-1"></i> Trở về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script đơn giản để ẩn hiện mật khẩu cho cả 2 ô
        const checkbox = document.getElementById('showPass');
        const passwordInputs = document.querySelectorAll('.input-password');

        checkbox.addEventListener('change', function() {
            const type = this.checked ? 'text' : 'password';
            passwordInputs.forEach(input => {
                input.type = type;
            });
        });
    </script>
}