@{
    ViewBag.Title = "Xác nhận";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    :root {
        /* Xanh biển đậm chuẩn sang trọng */
        --navy: #0d2137;
        --navy-hover: #001226;
        --soft-bg: #f4f7f9;
    }

    body {
        background-color: #e9ecef;
      
    }

    /* Khung card nhỏ gọn tinh tế */
    .auth-card {
        max-width: 380px;
        margin: auto;
        border: none;
        border-radius: 20px;
        background: #ffffff;
        /* Đổ bóng sâu tạo độ nổi */
        box-shadow: 0 15px 35px rgba(13, 33, 55, 0.12);
    }

    .card-body {
        padding: 2.5rem 2rem !important;
    }

    /* Ô nhập liệu */
    .form-control {
        border-radius: 10px;
        border: 1.5px solid #eaedf0;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: var(--navy);
            box-shadow: 0 0 0 3px rgba(13, 33, 55, 0.08);
        }

    /* Nút bấm Xanh biển đậm */
    .btn-navy {
        background-color: var(--navy);
        color: white;
        border-radius: 10px;
        padding: 12px;
        font-weight: 600;
        border: none;
        width: 100%;
        transition: 0.3s;
    }

        .btn-navy:hover {
            background-color: var(--navy-hover);
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(13, 33, 55, 0.2);
            color: white;
        }

    /* Ô nhập OTP tinh tế */
    .otp-field {
        letter-spacing: 6px;
        font-weight: 700;
        font-size: 1.3rem;
        color: var(--navy);
        background-color: var(--soft-bg);
        border: 1.5px dashed #cbd5e0;
    }

    /* Nhóm mật khẩu mới */
    .input-group-sub {
        background: #f8fafc;
        border-radius: 12px;
        padding: 15px;
        border: 1px solid #f1f5f9;
    }

    .text-navy {
        color: var(--navy);
    }

    .text-small {
        font-size: 0.85rem;
    }
</style>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 85vh;">
    <div class="card auth-card">
        <div class="card-body">

            <div class="text-center mb-4">
                <div class="mb-2 text-navy">
                    <i class="bi bi-shield-check" style="font-size: 2.2rem;"></i>
                </div>
                <h5 class="fw-bold mb-1" style="color: var(--navy);">Xác nhận mật khẩu</h5>
                <p class="text-muted text-small">Vui lòng nhập mã OTP và thiết lập mật khẩu mới</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 text-center text-small border-0 bg-danger bg-opacity-10 mb-3">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("VerifyOTP", "TaiKhoan_65130239", FormMethod.Post))
            {
                <div class="mb-4">
                    <label class="form-label text-small fw-bold text-muted text-uppercase" style="letter-spacing: 0.5px;">Mã xác thực</label>
                    <input name="otp" class="form-control text-center otp-field shadow-sm"
                           maxlength="6" placeholder="000000" required inputmode="numeric" />
                </div>

                <div class="input-group-sub mb-4 shadow-sm">
                    <div class="mb-2">
                        <input type="password" name="newPassword" class="form-control border-0"
                               placeholder="Mật khẩu mới" required />
                    </div>
                    <div>
                        <input type="password" name="confirmPassword" class="form-control border-0"
                               placeholder="Xác nhận lại" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-navy shadow-sm mt-2">
                    Hoàn tất đổi mật khẩu <i class="bi bi-check-circle-fill ms-1 small"></i>
                </button>
            }

            <div class="text-center mt-4">
                <a href="@Url.Action("ForgotPassword")" class="text-decoration-none text-small text-muted fw-bold">
                    Gửi lại mã xác thực?
                </a>
            </div>
        </div>
    </div>
</div>