@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
    }

    .forgot-password-card {
        border: none;
        border-radius: 20px;
        transition: transform 0.3s ease;
    }

    .btn-send {
        background: linear-gradient(45deg, #0d6efd, #0046af);
        border: none;
        padding: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.4);
            opacity: 0.9;
        }

    .icon-box {
        width: 80px;
        height: 80px;
        background: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 2rem;
    }

    .form-floating > label {
        color: #6c757d;
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-md-5 col-lg-4">
            <div class="card forgot-password-card shadow-lg">
                <div class="card-body p-5">

                    <div class="icon-box">
                        <i class="bi bi-shield-lock"></i>
                    </div>

                    <h3 class="text-center fw-bold mb-2">Quên mật khẩu?</h3>
                    <p class="text-muted text-center mb-4 small">Nhập email của bạn để nhận mã xác thực OTP thiết lập lại mật khẩu.</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    @using (Html.BeginForm("SendOTP", "TaiKhoan_65130239", FormMethod.Post))
                    {
                        <div class="form-floating mb-4">
                            <input type="email" name="email" class="form-control" id="floatingInput" placeholder="name@example.com" required />
                            <label for="floatingInput"><i class="bi bi-envelope me-2"></i>Email của bạn</label>
                        </div>

                        <button type="submit" class="btn btn-primary btn-send w-100 rounded-pill mb-3">
                            Gửi mã xác nhận <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    }

                    <div class="text-center mt-3">
                        <a href="@Url.Action("Login", "TaiKhoan_65130239")" class="text-decoration-none small fw-bold">
                            <i class="bi bi-chevron-left"></i> Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>