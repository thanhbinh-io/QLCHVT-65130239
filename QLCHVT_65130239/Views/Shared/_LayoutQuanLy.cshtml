<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - @ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            background: #212529;
            color: white;
            transition: all 0.3s;
            width: 260px;
            z-index: 1000;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.1);
                border-radius: 10px;
            }

        .nav-link {
            color: rgba(255,255,255,.7);
            border-radius: 8px;
            margin: 5px 15px;
            transition: 0.2s;
            font-size: 0.95rem;
        }

            .nav-link:hover {
                background: rgba(255,255,255,.1);
                color: white;
            }

            .nav-link.active {
                background: #0d6efd !important;
                color: white !important;
                font-weight: 600;
                box-shadow: 0 4px 10px rgba(13, 110, 253, 0.2);
            }

        /* 1. GIẢM PADDING CHUNG ĐỂ NỘI DUNG SÁT LÊN TRÊN */
        .main-content {
            padding: 12px 24px; /* Giảm từ 20px xuống 12px cho phần trên */
        }

        .admin-card {
            border: none;
            border-radius: 12px;
            transition: all 0.3s;
        }

            .admin-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
            }
    </style>
</head>
<body>
    @{ var action = ViewContext.RouteData.Values["action"].ToString(); }

    <div class="d-flex">
        <div class="sidebar d-none d-md-block">
            <div class="p-4 mb-2 border-bottom border-secondary text-center">
                <small class="text-secondary fw-bold" style="letter-spacing: 2px;">ADMIN</small>
            </div>
            <nav class="nav flex-column">
                <a href="@Url.Action("Index", "QuanLy_65130239")" class="nav-link @(action == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2 me-2"></i> Tổng quan
                </a>
                <a href="@Url.Action("DanhSachSanPham", "QuanLy_65130239")" class="nav-link @(action.Contains("SanPham") ? "active" : "")">
                    <i class="bi bi-box-seam me-2"></i> Sản phẩm
                </a>
                <a href="@Url.Action("DanhSachNhanVien", "QuanLy_65130239")" class="nav-link @(action.Contains("NhanVien") ? "active" : "")">
                    <i class="bi bi-people me-2"></i> Nhân viên
                </a>
                <a href="@Url.Action("DanhSachKhachHang", "QuanLy_65130239")" class="nav-link @(action == "DanhSachKhachHang" ? "active" : "")">
                    <i class="bi bi-person-badge me-2"></i> Khách hàng
                </a>
                <a href="@Url.Action("DanhSachDonHang", "QuanLy_65130239")" class="nav-link @(action == "DanhSachDonHang" ? "active" : "")">
                    <i class="bi bi-cart-check me-2"></i> Đơn hàng
                </a>
                <a href="@Url.Action("ThongKe", "QuanLy_65130239")" class="nav-link @(action == "ThongKe" ? "active" : "")">
                    <i class="bi bi-graph-up-arrow me-2"></i> Thống kê
                </a>
                <hr class="mx-3 border-secondary">
                <a href="@Url.Action("Logout", "TaiKhoan_65130239")" class="nav-link text-danger small"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a>
            </nav>
        </div>

        <div class="flex-grow-1">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 py-2 shadow-sm">
                <span class="navbar-brand fw-bold text-primary fs-3 mb-0" style="letter-spacing: -0.5px;">
                    <i class="bi bi-droplet-half me-2"></i>HỆ THỐNG QUẢN LÝ VẬT TƯ
                </span>
                <div class="ms-auto text-end">
                    <span class="text-muted small">Quyền: <strong class="text-dark">Quản lý</strong></span>
                </div>
            </nav>

            <div class="main-content">
                @RenderBody()
            </div>
        </div>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>